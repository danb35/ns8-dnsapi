# Add a tenant (one of the operator's customers). Its id is t<8 hex>.

import json
import os
import sys

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "pypkg"))
from dnsapi import state

request = json.load(sys.stdin)
with state.locked():
    tenants = state.tenants()
    tenant_id = state.new_tenant_id(tenants)
    tenants[tenant_id] = {
        "name": request["name"].strip(),
        "enabled": request.get("enabled", True),
        "zones": [],
        "created": state.now(),
    }
    state.save_tenants(tenants)
state.audit("add-tenant", tenant=tenant_id, name=tenants[tenant_id]["name"])
json.dump(state.tenant_view(tenant_id, tenants[tenant_id]), fp=sys.stdout)
