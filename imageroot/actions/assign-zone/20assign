# Give a zone to a tenant. Only whole zones that dnshelper lets dnsapi write
# in can be assigned (access "write" in list-zones, dnshelper 0.7.0): in full
# for a hosting customer, or only some records, such as dnshelper's ACME
# preset. The NS8 administrator decides that on dnshelper's Access page, and
# dnsapi cannot widen it. A zone belongs to at most one tenant.

import json
import os
import sys

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "pypkg"))
from dnsapi import state

import agent
from dnsapi import dnshelper

request = json.load(sys.stdin)
zone = request["zone"].lower().rstrip(".")
rdb = agent.redis_connect(use_replica=True)
target = dnshelper.find_instance(rdb)
if target is None:
    state.fail("zone", "dnshelper_missing", zone, "dnshelper is not installed")
try:
    writable = dnshelper.writable_zones(target)
except dnshelper.DnshelperError as exc:
    if exc.code == "unavailable":
        print(agent.SD_ERR + f"list-zones on {target} failed", file=sys.stderr)
        sys.exit(1)
    state.fail("zone", exc.code, zone, exc.message)
if zone not in writable:
    state.fail("zone", "zone_not_assignable", zone,
               "dnshelper does not let dnsapi write in this zone")
with state.locked():
    tenants = state.tenants()
    tenant = tenants.get(request["tenant"])
    if tenant is None:
        state.fail("tenant", "tenant_not_found", request["tenant"], "no such tenant")
    owner = state.zone_owner(tenants, zone)
    if owner not in (None, request["tenant"]):
        state.fail("zone", "zone_assigned", zone, "the zone belongs to another tenant")
    if zone not in tenant["zones"]:
        tenant["zones"] = sorted(tenant["zones"] + [zone])
        state.save_tenants(tenants)
state.audit("assign-zone", tenant=request["tenant"], zone=zone)
json.dump(state.tenant_view(request["tenant"], tenant), fp=sys.stdout)
