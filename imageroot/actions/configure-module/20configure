#
# Merge the request into state/api/settings.json and publish the API on its
# host name through Traefik (DESIGN.md, Security, Transport). The route
# instance is MODULE_ID, so ns8-traefik removes it with the module.
#
# set-route runs before the settings are saved: when Traefik refuses them
# (an address it can't parse, a Let's Encrypt certificate it can't get),
# the action fails with the settings unchanged.
#
# Before set-route, when publish_host_record is on and the host name is in a
# zone dnshelper manages, its CNAME to the node is added if missing (DESIGN.md,
# The API host name in DNS), so the certificate can be issued. That step never
# fails the action; its result goes to state/host-record.json.
#

import ipaddress
import json
import os
import sys

import agent
import agent.tasks

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "pypkg"))
from dnsapi import dnshelper, hostrecord

SETTINGS = "api/settings.json"
DEFAULTS = {"host": None, "lets_encrypt": False, "http2https": True, "ip_allowlist": [], "rate_limit": 60,
            "publish_host_record": True}


def validation_failed(field, value, error):
    agent.set_status("validation-failed")
    json.dump([{"field": field, "parameter": field, "value": value, "error": error}], fp=sys.stdout)
    sys.exit(2)


request = json.load(sys.stdin)

try:
    with open(SETTINGS) as fp:
        settings = {**DEFAULTS, **json.load(fp)}
except FileNotFoundError:
    settings = dict(DEFAULTS)

for key in DEFAULTS:
    if key in request:
        settings[key] = request[key]

if not settings["host"]:
    validation_failed("host", "", "host_required")
settings["host"] = settings["host"].lower().rstrip(".")

for value in settings["ip_allowlist"]:
    try:
        ipaddress.ip_network(value, strict=False)
    except ValueError:
        validation_failed("ip_allowlist", value, "bad_ip_address")

# The host name's CNAME to the node, through dnshelper
if settings["publish_host_record"]:
    rdb = agent.redis_connect(use_replica=True)
    target = dnshelper.find_instance(rdb)
    if target is None:
        record = {"host": settings["host"], "status": "error", "message": "dnshelper is not installed"}
    else:
        try:
            fqdn = hostrecord.node_fqdn()
            record = hostrecord.ensure(settings["host"], fqdn,
                                       lambda action, data: dnshelper.call(target, action, data),
                                       wait=settings["lets_encrypt"])
        except Exception as exc:
            record = {"host": settings["host"], "status": "error", "message": str(exc)}
else:
    record = {"host": settings["host"], "status": "disabled"}
print(f"API host record: {record['status']} {record.get('message', '')}", file=sys.stderr)
hostrecord.save(record)

response = agent.tasks.run(
    agent_id=agent.resolve_agent_id("traefik@node"),
    action="set-route",
    data={
        "instance": os.environ["MODULE_ID"],
        "url": "http://127.0.0.1:" + os.environ["TCP_PORT"],
        "host": settings["host"],
        # Clear a path prefix left from an earlier route: the API owns the
        # whole host name.
        "path": None,
        "lets_encrypt": settings["lets_encrypt"],
        "lets_encrypt_check": settings["lets_encrypt"],
        "http2https": settings["http2https"],
        # An empty list removes Traefik's allowlist middleware.
        "ip_allowlist": settings["ip_allowlist"],
    },
)

if response["exit_code"] != 0:
    print(agent.SD_ERR + "set-route failed: " + json.dumps(response.get("error") or response.get("output")), file=sys.stderr)
    # Traefik's validation errors name the same fields as this action's input.
    if isinstance(response.get("output"), list):
        agent.set_status("validation-failed")
        json.dump(response["output"], fp=sys.stdout)
        sys.exit(2)
    sys.exit(1)

os.makedirs("api", exist_ok=True)
with agent.safe_open(SETTINGS, "w") as fp:
    json.dump(settings, fp, indent=2)
    fp.write("\n")
