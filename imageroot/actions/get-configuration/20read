import json
import sys

DEFAULTS = {"host": None, "lets_encrypt": False, "http2https": True, "ip_allowlist": [], "rate_limit": 60}

try:
    with open("settings.json") as fp:
        settings = {**DEFAULTS, **json.load(fp)}
except FileNotFoundError:
    settings = dict(DEFAULTS)

json.dump({key: settings[key] for key in DEFAULTS}, fp=sys.stdout)
