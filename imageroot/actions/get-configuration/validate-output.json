{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "get-configuration output",
    "$id": "http://schema.nethserver.org/dnsapi/get-configuration-output.json",
    "description": "Get dnsapi configuration. host is null until configure-module has run.",
    "examples": [
        {
            "host": "dnsapi.example.com",
            "lets_encrypt": true,
            "http2https": true,
            "ip_allowlist": [
                "203.0.113.10"
            ],
            "rate_limit": 60
        }
    ],
    "type": "object",
    "additionalProperties": false,
    "required": [
        "host",
        "lets_encrypt",
        "http2https",
        "ip_allowlist",
        "rate_limit"
    ],
    "properties": {
        "host": {
            "type": [
                "string",
                "null"
            ],
            "description": "The API host name"
        },
        "lets_encrypt": {
            "type": "boolean"
        },
        "http2https": {
            "type": "boolean"
        },
        "ip_allowlist": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "rate_limit": {
            "type": "integer"
        }
    }
}
