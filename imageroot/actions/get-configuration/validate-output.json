{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "get-configuration output",
    "$id": "http://schema.nethserver.org/dnsapi/get-configuration-output.json",
    "description": "Get dnsapi configuration. host is null until configure-module has run.",
    "examples": [
        {
            "host": "dnsapi.example.com",
            "lets_encrypt": true,
            "ip_allowlist": [
                "203.0.113.10"
            ],
            "rate_limit": 60,
            "publish_host_record": true,
            "revoke_cleartext_keys": true,
            "host_record": {
                "host": "dnsapi.example.com",
                "target": "node1.example.com",
                "zone": "example.com",
                "status": "ok",
                "existing": [
                    "CNAME node1.example.com."
                ],
                "message": "",
                "checked": "2026-11-21T18:00:00Z"
            }
        }
    ],
    "type": "object",
    "additionalProperties": false,
    "required": [
        "host",
        "lets_encrypt",
        "ip_allowlist",
        "rate_limit",
        "publish_host_record",
        "revoke_cleartext_keys",
        "host_record"
    ],
    "properties": {
        "host": {
            "type": [
                "string",
                "null"
            ],
            "description": "The API host name"
        },
        "lets_encrypt": {
            "type": "boolean"
        },
        "ip_allowlist": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "rate_limit": {
            "type": "integer"
        },
        "publish_host_record": {
            "type": "boolean"
        },
        "revoke_cleartext_keys": {
            "type": "boolean"
        },
        "host_record": {
            "type": [
                "object",
                "null"
            ],
            "description": "The host name's CNAME to the node, as configure-module last found it; null before it has run",
            "properties": {
                "host": {
                    "type": "string"
                },
                "target": {
                    "type": "string"
                },
                "zone": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "status": {
                    "enum": [
                        "ok",
                        "created",
                        "conflict",
                        "not_managed",
                        "not_permitted",
                        "apex",
                        "disabled",
                        "error"
                    ]
                },
                "existing": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "The records found at the name, as 'TYPE data'"
                },
                "propagated": {
                    "type": "boolean"
                },
                "message": {
                    "type": "string"
                },
                "checked": {
                    "type": "string"
                }
            }
        }
    }
}
