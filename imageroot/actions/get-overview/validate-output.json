{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "get-overview output",
    "$id": "http://schema.nethserver.org/dnsapi/get-overview-output.json",
    "description": "What the Status page shows. dnshelper_error: dnshelper_missing, dnshelper_too_old or unavailable",
    "examples": [
        {
            "host": "dnsapi.example.com",
            "url": "https://dnsapi.example.com/v1/",
            "dnshelper": "dnshelper1",
            "dnshelper_error": null,
            "zones_writable": 3,
            "zones_full": 2,
            "zones_assigned": 2,
            "tenants": 2,
            "tenants_disabled": 0,
            "keys_operator": 1,
            "keys_tenant": 3
        }
    ],
    "type": "object",
    "required": [
        "host",
        "url",
        "dnshelper",
        "dnshelper_error",
        "zones_writable",
        "zones_full",
        "zones_assigned",
        "tenants",
        "tenants_disabled",
        "keys_operator",
        "keys_tenant"
    ],
    "properties": {
        "host": {
            "type": [
                "string",
                "null"
            ]
        },
        "url": {
            "type": [
                "string",
                "null"
            ]
        },
        "dnshelper": {
            "type": [
                "string",
                "null"
            ]
        },
        "dnshelper_error": {
            "type": [
                "string",
                "null"
            ]
        },
        "zones_writable": {
            "type": "integer",
            "minimum": 0
        },
        "zones_full": {
            "type": "integer",
            "minimum": 0
        },
        "zones_assigned": {
            "type": "integer",
            "minimum": 0
        },
        "tenants": {
            "type": "integer",
            "minimum": 0
        },
        "tenants_disabled": {
            "type": "integer",
            "minimum": 0
        },
        "keys_operator": {
            "type": "integer",
            "minimum": 0
        },
        "keys_tenant": {
            "type": "integer",
            "minimum": 0
        }
    }
}
