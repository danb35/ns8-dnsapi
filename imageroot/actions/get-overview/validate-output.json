{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "get-overview output",
    "$id": "http://schema.nethserver.org/dnsapi/get-overview-output.json",
    "description": "What the Status page shows. dnshelper_error: dnshelper_missing, dnshelper_too_old or unavailable",
    "examples": [
        {
            "host": "dnsapi.example.com",
            "url": "https://dnsapi.example.com/v1/",
            "dnshelper": "dnshelper1",
            "dnshelper_error": null,
            "zones_writable": 3,
            "zones_full": 2,
            "zones_assigned": 2,
            "tenants": 2,
            "tenants_disabled": 0,
            "keys_operator": 1,
            "keys_tenant": 3,
            "host_record": null,
            "exposed_keys": [
                {
                    "time": "2026-11-22T09:30:00Z",
                    "key": "a1b2c3d4",
                    "owner": "t1a2b3c4d",
                    "address": "203.0.113.10",
                    "tenant_name": "Acme Shop"
                }
            ]
        }
    ],
    "type": "object",
    "required": [
        "host",
        "url",
        "dnshelper",
        "dnshelper_error",
        "zones_writable",
        "zones_full",
        "zones_assigned",
        "tenants",
        "tenants_disabled",
        "keys_operator",
        "keys_tenant",
        "host_record",
        "exposed_keys"
    ],
    "properties": {
        "host": {
            "type": [
                "string",
                "null"
            ]
        },
        "url": {
            "type": [
                "string",
                "null"
            ]
        },
        "dnshelper": {
            "type": [
                "string",
                "null"
            ]
        },
        "dnshelper_error": {
            "type": [
                "string",
                "null"
            ]
        },
        "zones_writable": {
            "type": "integer",
            "minimum": 0
        },
        "zones_full": {
            "type": "integer",
            "minimum": 0
        },
        "zones_assigned": {
            "type": "integer",
            "minimum": 0
        },
        "tenants": {
            "type": "integer",
            "minimum": 0
        },
        "tenants_disabled": {
            "type": "integer",
            "minimum": 0
        },
        "keys_operator": {
            "type": "integer",
            "minimum": 0
        },
        "keys_tenant": {
            "type": "integer",
            "minimum": 0
        },
        "host_record": {
            "type": [
                "object",
                "null"
            ],
            "description": "The host name's CNAME to the node, as configure-module last found it; null before it has run",
            "properties": {
                "host": {
                    "type": "string"
                },
                "target": {
                    "type": "string"
                },
                "zone": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "status": {
                    "enum": [
                        "ok",
                        "created",
                        "conflict",
                        "not_managed",
                        "not_permitted",
                        "apex",
                        "disabled",
                        "error"
                    ]
                },
                "existing": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "The records found at the name, as 'TYPE data'"
                },
                "propagated": {
                    "type": "boolean"
                },
                "message": {
                    "type": "string"
                },
                "checked": {
                    "type": "string"
                }
            }
        },
        "exposed_keys": {
            "type": "array",
            "description": "Keys revoked in the last 7 days because the API received them over plain HTTP, newest first",
            "items": {
                "type": "object",
                "required": [
                    "time",
                    "key",
                    "owner",
                    "address",
                    "tenant_name"
                ],
                "properties": {
                    "time": {
                        "type": "string"
                    },
                    "key": {
                        "type": "string"
                    },
                    "owner": {
                        "type": "string",
                        "description": "operator, or the tenant id"
                    },
                    "address": {
                        "type": "string"
                    },
                    "tenant_name": {
                        "type": "string",
                        "description": "The tenant's name; empty for an operator key"
                    }
                }
            }
        }
    }
}
