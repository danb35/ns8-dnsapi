# The keys, without their hashes. Optional "owner": "operator" or a tenant id.

import json
import os
import sys

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "pypkg"))
from dnsapi import state

request = json.load(sys.stdin) or {}
used = state.last_used()
result = [state.key_view(k, r, used) for k, r in sorted(state.keys().items())
          if request.get("owner") in (None, r["owner"])]
json.dump({"keys": result}, fp=sys.stdout)
