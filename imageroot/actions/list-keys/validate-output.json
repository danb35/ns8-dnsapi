{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "list-keys output",
    "$id": "http://schema.nethserver.org/dnsapi/list-keys-output.json",
    "description": "The keys, without their hashes",
    "examples": [],
    "type": "object",
    "required": [
        "keys"
    ],
    "properties": {
        "keys": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "owner",
                    "scope",
                    "label",
                    "allowlist",
                    "expires",
                    "created",
                    "last_used"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}$",
                        "description": "Key id"
                    },
                    "owner": {
                        "type": "string",
                        "description": "'operator' or a tenant id"
                    },
                    "scope": {
                        "enum": [
                            "read",
                            "write"
                        ]
                    },
                    "label": {
                        "type": "string"
                    },
                    "allowlist": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "expires": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "created": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "last_used": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                }
            }
        }
    }
}
