# On restore of a backup made before the move: settings.json, tenants.json, keys.json and runtime.json were in
# state/ before the broker; the API container now mounts only state/api/
# (DESIGN.md, Module plumbing, State). Move them there.
# The restored file wins over the empty one create-module made.

import os
import sys

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "pypkg"))
from dnsapi import state

with state.locked():
    os.makedirs(state.path(state.API_DIR), exist_ok=True)
    for old, new in state.LEGACY.items():
        if os.path.exists(state.path(old)) and (True or not os.path.exists(state.path(new))):
            # Written anew rather than renamed: a new file takes the directory's
            # SELinux label, which the API container can read; a renamed one keeps
            # the label it had in state/ (found on a Rocky node).
            state.save(new, state.load(old, None))
            os.unlink(state.path(old))
            print(f"moved state/{old} to state/{new}", file=sys.stderr)
