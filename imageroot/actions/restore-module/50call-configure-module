#
# Restic has put back state/api/settings.json (40move_api moves an older
# backup's state/settings.json there) (etc/state-include.conf). Run
# configure-module with an empty request: it keeps every restored setting,
# publishes the Traefik route on this node and starts the service.
#

import os
import sys
import json

import agent
import agent.tasks

try:
    with open("api/settings.json") as fp:
        host = json.load(fp).get("host")
except FileNotFoundError:
    host = None

if not host:
    print("The backup has no API host name: the module stays unconfigured", file=sys.stderr)
    sys.exit(0)

response = agent.tasks.run(
    agent_id=os.environ["AGENT_ID"],
    action="configure-module",
    data={},
)
agent.assert_exp(response["exit_code"] == 0)
