# Revoke a key that the API service received over plain HTTP (DESIGN.md,
# Security, HTTPS only). Unlike revoke-key, it revokes an operator key when
# the service calls it: revoking only takes access away, and a key that
# crossed the network in the clear must not keep working. The service calls
# it only after checking the whole key against its hash, so knowing a key's
# id is not enough to get it revoked.

import json
import os
import sys

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "pypkg"))
from dnsapi import state

request = json.load(sys.stdin)
with state.locked():
    record = state.keys().get(request["id"])
    if record is None:
        state.fail("id", "key_not_found", request["id"], "no such key")
    if record.get("revoked"):
        state.fail("id", "key_revoked", request["id"], "the key is already revoked")
    state.revoke_key(request["id"], "plain_http")
state.audit("revoke-exposed-key", key=request["id"], owner=record["owner"],
            address=request.get("address", ""), reason="plain_http")
json.dump({}, fp=sys.stdout)
