# Delete a key; it stops working on the API's next request.

import json
import os
import sys

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "pypkg"))
from dnsapi import state

request = json.load(sys.stdin)
with state.locked():
    keys = state.keys()
    record = keys.pop(request["id"], None)
    if record is None:
        state.fail("id", "key_not_found", request["id"], "no such key")
    if record["owner"] == "operator" and state.caller() == os.environ.get("AGENT_ID"):
        state.fail("id", "not_permitted", request["id"], "operator keys are revoked by a cluster administrator")
    state.save_keys(keys)
state.audit("revoke-key", key=request["id"], owner=record["owner"])
json.dump({}, fp=sys.stdout)
