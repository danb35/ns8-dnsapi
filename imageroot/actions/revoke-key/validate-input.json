{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "revoke-key input",
    "$id": "http://schema.nethserver.org/dnsapi/revoke-key-input.json",
    "description": "Revoke an API key; its record is kept, marked revoked",
    "examples": [
        {
            "id": "a1b2c3d4"
        }
    ],
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}$",
            "description": "Key id"
        }
    },
    "required": [
        "id"
    ]
}
