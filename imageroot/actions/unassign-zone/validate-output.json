{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "unassign-zone output",
    "$id": "http://schema.nethserver.org/dnsapi/unassign-zone-output.json",
    "description": "The tenant",
    "examples": [],
    "type": "object",
    "required": [
        "id",
        "name",
        "enabled",
        "zones",
        "created"
    ],
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^t[0-9a-f]{8}$",
            "description": "Tenant id"
        },
        "name": {
            "type": "string"
        },
        "enabled": {
            "type": "boolean"
        },
        "zones": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "created": {
            "type": [
                "string",
                "null"
            ]
        },
        "keys": {
            "type": "integer",
            "description": "Number of keys"
        }
    }
}
