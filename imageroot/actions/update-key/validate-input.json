{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "update-key input",
    "$id": "http://schema.nethserver.org/dnsapi/update-key-input.json",
    "description": "Change an API key's label, allowed addresses or expiry; the fields left out keep their value. Owner, scope and restrict cannot be changed, nor can a revoked key",
    "examples": [
        {
            "id": "a1b2c3d4",
            "allowlist": [
                "203.0.113.20"
            ]
        },
        {
            "id": "b2c3d4e5",
            "label": "host1 certificates",
            "expires": "2027-12-31T00:00:00Z"
        }
    ],
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}$",
            "description": "Key id"
        },
        "label": {
            "type": "string",
            "maxLength": 100
        },
        "allowlist": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
            },
            "description": "IP addresses or CIDR networks the key may be used from; empty for any"
        },
        "expires": {
            "type": [
                "string",
                "null"
            ],
            "description": "ISO 8601 date-time in the future after which the key is refused; null for never. An expired key given a later expiry works again"
        }
    },
    "required": [
        "id"
    ]
}
