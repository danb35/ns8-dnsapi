# Write state/api/runtime.json for the API service, which cannot read Redis:
# the dnshelper instance to call, and how many trusted proxies stand in
# front of this node's Traefik (its PROXIES_DEPTH, set by
# set-trusted-proxies), to find the client address in X-Forwarded-For.
# Runs before the service starts, from configure-module, and on the events
# that can change either. The service rereads the file when it changes.

import json
import os
import sys

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "pypkg"))
import agent
from dnsapi import dnshelper, state

rdb = agent.redis_connect(use_replica=True)
runtime = {"dnshelper": dnshelper.find_instance(rdb), "proxies_depth": 0}
try:
    traefik = agent.resolve_agent_id("traefik@node")
    runtime["proxies_depth"] = int(rdb.hget(traefik + "/environment", "PROXIES_DEPTH") or 0)
except Exception as exc:
    print(agent.SD_WARNING + f"cannot read Traefik's PROXIES_DEPTH: {exc}", file=sys.stderr)

if state.load(state.RUNTIME, None) != runtime:
    state.save(state.RUNTIME, runtime)
    print(f"runtime: dnshelper={runtime['dnshelper']} proxies_depth={runtime['proxies_depth']}", file=sys.stderr)
