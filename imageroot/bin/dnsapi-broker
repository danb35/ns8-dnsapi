# The broker between the API service and NS8 (pypkg/dnsapi/broker.py). Run by
# systemd/user/dnsapi-broker.service under runagent, which provides the
# module's credentials and ns8-core's agent package.

import argparse
import logging
import os
import signal
import sys
import threading
import time

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "pypkg"))
import agent
from dnsapi import broker, dnshelper

parser = argparse.ArgumentParser(prog="dnsapi-broker")
parser.add_argument("--socket", required=True)
args = parser.parse_args()
logging.basicConfig(stream=sys.stderr, level=logging.INFO, format="%(levelname)s %(message)s")

cache = {"at": 0.0, "agent": None}
cache_lock = threading.Lock()


def find_dnshelper():
    """The dnshelper instance to use; looked up again after 30 s."""
    with cache_lock:
        if time.monotonic() - cache["at"] > 30:
            try:
                cache["agent"] = dnshelper.find_instance(agent.redis_connect(use_replica=True))
                cache["at"] = time.monotonic()
            except Exception as exc:
                logging.error("cannot look up dnshelper: %s", exc)
        return cache["agent"]


server = broker.Server(args.socket, broker.Broker(find_dnshelper, os.environ["AGENT_ID"]))
signal.signal(signal.SIGTERM, lambda *a: threading.Thread(target=server.shutdown, daemon=True).start())
logging.info("listening on %s", args.socket)
server.serve_forever()
server.server_close()
