#
# The dnsapi API service (server/ in the repository), one rootless
# container. It listens on 127.0.0.1 only; Traefik routes the API host name
# to it (configure-module).
#
# The container holds no NS8 credentials: it asks dnsapi-broker.service to
# run tasks, over the Unix socket in %t/dnsapi-broker (DESIGN.md, Runtime,
# The broker). It mounts only state/api/ read-only (the files the actions
# write for it; a directory, because the actions replace files by renaming),
# state/usage/ (last-used times, activity) and the broker's socket directory.
# agent.env and apitoken.cache, in state/, are not in the container.
#
# --network=host: Traefik's connections then come from loopback, which the
# X-Forwarded-For handling relies on; it binds 127.0.0.1:${TCP_PORT} itself.
# --userns=keep-id --user %U:%G: the module's own uid, to read the 0600 files
# and reach the 0600 socket. No capabilities, no privilege gain.
#
[Unit]
Description=dnsapi API server
Wants=network-online.target dnsapi-broker.service
After=network-online.target dnsapi-broker.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=always
TimeoutStopSec=70
# podman stop sends SIGTERM; conmon then exits 143 (137 after SIGKILL).
SuccessExitStatus=143 137
ExecStartPre=/bin/rm -f %t/dnsapi.pid %t/dnsapi.ctr-id
ExecStartPre=/bin/mkdir -p %E/state/api %E/state/usage %t/dnsapi-broker
ExecStartPre=-runagent discover-runtime
ExecStart=/usr/bin/podman run \
    --detach \
    --conmon-pidfile=%t/dnsapi.pid \
    --cidfile=%t/dnsapi.ctr-id \
    --cgroups=no-conmon \
    --replace --name=%N \
    --network=host \
    --userns=keep-id --user=%U:%G \
    --cap-drop=all --security-opt=no-new-privileges \
    --read-only \
    --volume=%E/state/api:/srv/state:ro,z \
    --volume=%E/state/usage:/srv/usage:Z \
    --volume=%t/dnsapi-broker:/run/broker:z \
    ${DNSAPI_SERVER_IMAGE} \
    --host=127.0.0.1 --port=${TCP_PORT}
# podman run --detach returns once the container exists, before the service
# listens: hold the start until it answers, so configure-module returns a
# working API.
ExecStartPost=/usr/bin/curl --silent --fail --output /dev/null --max-time 3 \
    --retry 30 --retry-delay 1 --retry-max-time 30 --retry-connrefused --retry-all-errors \
    http://127.0.0.1:${TCP_PORT}/v1/status
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/dnsapi.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/dnsapi.ctr-id
PIDFile=%t/dnsapi.pid
Type=forking

[Install]
WantedBy=default.target
