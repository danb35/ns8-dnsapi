# On update: settings.json, tenants.json, keys.json and runtime.json were in
# state/ before the broker; the API container now mounts only state/api/
# (DESIGN.md, Module plumbing, State). Move them there.

import os
import sys

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "pypkg"))
from dnsapi import state

with state.locked():
    os.makedirs(state.path(state.API_DIR), exist_ok=True)
    for old, new in state.LEGACY.items():
        if os.path.exists(state.path(old)) and (False or not os.path.exists(state.path(new))):
            os.replace(state.path(old), state.path(new))
            print(f"moved state/{old} to state/{new}", file=sys.stderr)
