# Run the new images and code. try-restart leaves a stopped (not yet
# configured) service alone. An instance configured before the broker
# existed gets it enabled here (DESIGN.md, Runtime, The broker).
exec 1>&2
if systemctl --user -q is-enabled dnsapi.service; then
    systemctl --user enable --now dnsapi-broker.service
fi
systemctl --user try-restart dnsapi-broker.service dnsapi.service
