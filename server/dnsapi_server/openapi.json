      "$ref": "#/components/responses/Error"
     },
     "403": {
      "$ref": "#/components/responses/Error"
     },
     "404": {
      "$ref": "#/components/responses/Error"
     },
     "429": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  }
 },
 "components": {
  "securitySchemes": {
   "bearer": {
    "type": "http",
    "scheme": "bearer",
    "description": "dnsapi_<8 hex>_<52 base32>"
   },
   "basic": {
    "type": "http",
    "scheme": "basic",
    "description": "Only on /v1/acme/*: any user name, the key as the password"
   }
  },
  "responses": {
   "Error": {
    "description": "An error",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "required": [
     "error"
    ],
    "properties": {
     "error": {
      "type": "object",
      "required": [
       "code",
       "message",
       "field"
      ],
      "properties": {
       "code": {
        "type": "string",
        "description": "invalid_request, invalid_json, missing_key, invalid_key, key_expired, insufficient_scope, tenant_disabled, address_not_allowed, restricted_key, outside_restriction, not_found, zone_not_found, tenant_not_found, key_not_found, stale, conflict, zone_assigned, zone_not_assignable, body_too_large, rate_limited, upstream_error, upstream_timeout, unavailable, dnshelper_missing, and dnshelper's own codes such as not_permitted and forbidden"
       },
       "message": {
        "type": "string"
       },
       "field": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     }
    }
   },
   "Status": {
    "type": "object",
    "properties": {
     "status": {
      "const": "ok"
     }
    }
   },
   "Record": {
    "type": "object",
    "required": [
     "name",
     "type",
     "ttl",
     "data"
    ],
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string",
      "description": "Relative to the zone; @ for the apex",
      "examples": [
       "www"
      ]
     },
     "type": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{1,10}$",
      "examples": [
       "A"
      ]
     },
     "ttl": {
      "type": "integer",
      "minimum": 0,
      "description": "Seconds; 0 or absent lets the DNS host choose"
     },
     "data": {
      "type": "string",
      "description": "Zone-file form without quotes: TXT is one plain string, MX \"10 mail.example.com.\", SRV \"priority weight port target\"",
      "examples": [
       "192.0.2.1"
      ]
     },
     "owned_by": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "NS8 modules that wrote the record and may write it again"
     }
    }
   },
   "RecordInput": {
    "type": "object",
    "required": [
     "name",
     "type",
     "data"
    ],
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string",
      "description": "Relative to the zone; @ for the apex",
      "examples": [
       "www"
      ]
     },
     "type": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{1,10}$",
      "examples": [
       "A"
      ]
     },
     "ttl": {
      "type": "integer",
      "minimum": 0,
      "description": "Seconds; 0 or absent lets the DNS host choose"
     },
     "data": {
      "type": "string",
      "description": "Zone-file form without quotes: TXT is one plain string, MX \"10 mail.example.com.\", SRV \"priority weight port target\"",
      "examples": [
       "192.0.2.1"
      ]
     }
    }
   },
   "RecordMatch": {
    "type": "object",
    "required": [
     "name"
    ],
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string",
      "description": "Relative to the zone; @ for the apex",
      "examples": [
       "www"
      ]
     },
     "type": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{1,10}$",
      "examples": [
       "A"
      ]
     },
     "ttl": {
      "type": "integer",
      "minimum": 0,
      "description": "Seconds; 0 or absent lets the DNS host choose"
     },
     "data": {
      "type": "string",
      "description": "Zone-file form without quotes: TXT is one plain string, MX \"10 mail.example.com.\", SRV \"priority weight port target\"",
      "examples": [
       "192.0.2.1"
      ]
     }
    },
    "description": "A record to delete: a type, ttl or data left out matches anything"
   },
   "Zone": {
    "type": "object",
    "required": [
     "zone",
     "provider",
     "full"
    ],
    "properties": {
     "zone": {
      "type": "string"
     },
     "provider": {
      "type": [
       "string",
       "null"
      ]
     },
     "full": {
      "type": "boolean",
      "description": "false: dnshelper lets dnsapi change only some records, such as ACME challenges"
     },
     "tenant": {
      "type": [
       "string",
       "null"
      ],
      "description": "Operator keys only"
     }
    }
   },
   "ZoneList": {
    "type": "object",
    "properties": {
     "zones": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Zone"
      }
     }
    }
   },
   "RecordList": {
    "type": "object",
    "properties": {
     "zone": {
      "type": "string"
     },
     "records": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Record"
      }
     }
    }
   },
   "RecordsRequest": {
    "type": "object",
    "required": [
     "records"
    ],
    "properties": {
     "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
       "$ref": "#/components/schemas/RecordInput"
      }
     },
     "dry_run": {
      "type": "boolean"
     }
    }
   },
   "DeleteRequest": {
    "type": "object",
    "required": [
     "records"
    ],
    "properties": {
     "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
       "$ref": "#/components/schemas/RecordMatch"
      }
     },
     "dry_run": {
      "type": "boolean"
     }
    }
   },
   "ChangesRequest": {
    "type": "object",
    "properties": {
     "remove": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/RecordInput"
      }
     },
     "add": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/RecordInput"
      }
     },
     "dry_run": {
      "type": "boolean"
     }
    },
    "description": "At most 100 records in all"
   },
   "Warning": {
    "type": "object",
    "properties": {
     "code": {
      "const": "owned_by_module"
     },
     "record": {
      "$ref": "#/components/schemas/Record"
     },
     "modules": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "message": {
      "type": "string"
     }
    }
   },
   "ChangeResult": {
    "type": "object",
    "required": [
     "zone",
     "dry_run",
     "changes",
     "warnings",
     "records"
    ],
    "properties": {
     "zone": {
      "type": "string"
     },
     "dry_run": {
      "type": "boolean"
     },
     "changes": {
      "type": "object",
      "properties": {
       "add": {
        "type": "array",
        "items": {
         "$ref": "#/components/schemas/Record"
        }
       },
       "remove": {
        "type": "array",
        "items": {
         "$ref": "#/components/schemas/Record"
        }
       }
      }
     },
     "warnings": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Warning"
      }
     },
     "records": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Record"
      },
      "description": "The zone's records after the change, as the DNS host reports them"
     }
    }
   },
   "Propagation": {
    "type": "object",
    "description": "dnshelper's check-propagation output",
    "properties": {
     "zone": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "type": {
      "type": "string"
     },
     "records": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Record"
      }
     },
     "servers_from": {
      "enum": [
       "dns",
       "provider"
      ]
     },
     "servers": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "server": {
         "type": "string"
        },
        "address": {
         "type": "string"
        },
        "status": {
         "enum": [
          "same",
          "different",
          "error"
         ]
        },
        "values": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "message": {
         "type": "string"
        }
       }
      }
     }
    }
   },
   "AcmeRequest": {
    "type": "object",
    "required": [
     "fqdn",
     "value"
    ],
    "properties": {
     "fqdn": {
      "type": "string",
      "examples": [
       "_acme-challenge.www.example.com."
      ]
     },
     "value": {
      "type": "string",
      "maxLength": 255
     }
    }
   },
   "AcmeResult": {
    "type": "object",
    "properties": {
     "fqdn": {
      "type": "string"
     },
     "value": {
      "type": "string"
     },
     "zone": {
      "type": "string"
     },
     "changes": {
      "$ref": "#/components/schemas/ChangeResult/properties/changes"
     }
    }
   },
   "Tenant": {
    "type": "object",
    "required": [
     "id",
     "name",
     "enabled",
     "zones",
     "created"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "enabled": {
      "type": "boolean"
     },
     "zones": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "created": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time"
     }
    }
   },
   "TenantList": {
    "type": "object",
    "properties": {
     "tenants": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Tenant"
      }
     }
    }
   },
   "TenantRequest": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
     },
     "enabled": {
      "type": "boolean"
     }
    }
   },
   "Restrict": {
    "oneOf": [
     {
      "type": "null"
     },
     {
      "const": "acme",
      "description": "_acme-challenge and _acme-challenge.* TXT records"
     },
     {
      "type": "object",
      "required": [
       "names"
      ],
      "properties": {
       "names": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "description": "Relative to the zone; * and ? are wildcards"
       },
       "types": {
        "type": "array",
        "items": {
         "type": "string"
        }
       }
      }
     }
    ]
   },
   "Key": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "owner": {
      "type": "string"
     },
     "scope": {
      "enum": [
       "read",
       "write"
      ]
     },
     "label": {
      "type": "string"
     },
     "allowlist": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "expires": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time"
     },
     "restrict": {
      "type": [
       "object",
       "null"
      ]
     },
     "created": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time"
     },
     "last_used": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time"
     }
    }
   },
   "KeyList": {
    "type": "object",
    "properties": {
     "keys": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Key"
      }
     }
    }
   },
   "KeyRequest": {
    "type": "object",
    "required": [
     "scope"
    ],
    "properties": {
     "scope": {
      "enum": [
       "read",
       "write"
      ]
     },
     "label": {
      "type": "string",
      "maxLength": 100
     },
     "allowlist": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "IP addresses or CIDR networks"
     },
     "expires": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time"
     },
     "restrict": {
      "$ref": "#/components/schemas/Restrict"
     }
    }
   },
   "NewKey": {
    "allOf": [
     {
      "$ref": "#/components/schemas/Key"
     },
     {
      "type": "object",
      "required": [
       "key"
      ],
      "properties": {
       "key": {
        "type": "string"
       }
      }
     }
    ]
   }
  }
 }
}
