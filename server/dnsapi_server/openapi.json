 "components": {
  "securitySchemes": {
   "bearer": {
    "type": "http",
    "scheme": "bearer",
    "description": "dnsapi_<8 hex>_<52 base32>"
   },
   "basic": {
    "type": "http",
    "scheme": "basic",
    "description": "Only on /v1/acme/*: any user name, the key as the password"
   }
  },
  "responses": {
   "Error": {
    "description": "An error",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "required": [
     "error"
    ],
    "properties": {
     "error": {
      "type": "object",
      "required": [
       "code",
       "message",
       "field"
      ],
      "properties": {
       "code": {
        "type": "string",
        "description": "invalid_request, not_editable, invalid_json, missing_key, invalid_key, key_expired, key_revoked, insufficient_scope, tenant_disabled, address_not_allowed, restricted_key, outside_restriction, not_found, zone_not_found, tenant_not_found, key_not_found, stale, conflict, zone_assigned, zone_not_assignable, zone_already_configured, zone_overlaps, unknown_provider, unknown_field, required, invalid_zone, cleanup_failed, reserved_name, https_required, body_too_large, rate_limited, too_many_concurrent, busy, upstream_error, upstream_timeout, unavailable, dnshelper_missing, not_granted, and dnshelper's own codes such as not_permitted and forbidden"
       },
       "message": {
        "type": "string"
       },
       "field": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     }
    }
   },
   "Status": {
    "type": "object",
    "properties": {
     "status": {
      "const": "ok"
     }
    }
   },
   "Record": {
    "type": "object",
    "required": [
     "name",
     "type",
     "ttl",
     "data"
    ],
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string",
      "description": "Relative to the zone; @ for the apex",
      "examples": [
       "www"
      ]
     },
     "type": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{1,10}$",
      "examples": [
       "A"
      ]
     },
     "ttl": {
      "type": "integer",
      "minimum": 0,
      "description": "Seconds; 0 or absent lets the DNS host choose"
     },
     "data": {
      "type": "string",
      "description": "Zone-file form without quotes: TXT is one plain string, MX \"10 mail.example.com.\", SRV \"priority weight port target\"",
      "examples": [
       "192.0.2.1"
      ]
     },
     "owned_by": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "NS8 modules that wrote the record and may write it again"
     }
    }
   },
   "RecordInput": {
    "type": "object",
    "required": [
     "name",
     "type",
     "data"
    ],
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string",
      "description": "Relative to the zone; @ for the apex",
      "examples": [
       "www"
      ]
     },
     "type": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{1,10}$",
      "examples": [
       "A"
      ]
     },
     "ttl": {
      "type": "integer",
      "minimum": 0,
      "description": "Seconds; 0 or absent lets the DNS host choose"
     },
     "data": {
      "type": "string",
      "description": "Zone-file form without quotes: TXT is one plain string, MX \"10 mail.example.com.\", SRV \"priority weight port target\"",
      "examples": [
       "192.0.2.1"
      ]
     }
    }
   },
   "RecordMatch": {
    "type": "object",
    "required": [
     "name"
    ],
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string",
      "description": "Relative to the zone; @ for the apex",
      "examples": [
       "www"
      ]
     },
     "type": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{1,10}$",
      "examples": [
       "A"
      ]
     },
     "ttl": {
      "type": "integer",
      "minimum": 0,
      "description": "Seconds; 0 or absent lets the DNS host choose"
     },
     "data": {
      "type": "string",
      "description": "Zone-file form without quotes: TXT is one plain string, MX \"10 mail.example.com.\", SRV \"priority weight port target\"",
      "examples": [
       "192.0.2.1"
      ]
     }
    },
    "description": "A record to delete: a type, ttl or data left out matches anything"
   },
   "Zone": {
    "type": "object",
    "required": [
     "zone",
     "provider",
     "full"
    ],
    "properties": {
     "zone": {
      "type": "string"
     },
     "provider": {
      "type": [
       "string",
       "null"
      ]
     },
     "full": {
      "type": "boolean",
      "description": "false: dnshelper lets dnsapi change only some records, such as ACME challenges"
     },
     "tenant": {
      "type": [
       "string",
       "null"
      ],
      "description": "Operator keys only"
     },
     "hosted": {
      "type": "boolean",
      "description": "Operator keys only: added with POST /v1/zones, so DELETE /v1/zones/{zone} can remove it"
     }
    }
   },
   "Credentials": {
    "type": "object",
    "additionalProperties": {
     "type": "string",
     "maxLength": 4096
    },
    "description": "The DNS host's credential fields, by the names GET /v1/providers gives",
    "examples": [
     {
      "api_token": "..."
     }
    ]
   },
   "HostedZoneRequest": {
    "type": "object",
    "required": [
     "zone",
     "provider",
     "credentials"
    ],
    "properties": {
     "zone": {
      "type": "string",
      "examples": [
       "customer.example"
      ]
     },
     "provider": {
      "type": "string",
      "description": "A name from GET /v1/providers",
      "examples": [
       "cloudflare"
      ]
     },
     "credentials": {
      "$ref": "#/components/schemas/Credentials"
     },
     "tenant": {
      "type": [
       "string",
       "null"
      ],
      "description": "Assign the zone to this tenant"
     },
     "dry_run": {
      "type": "boolean"
     }
    }
   },
   "HostedZone": {
    "type": "object",
    "required": [
     "zone",
     "provider",
     "tenant",
     "dry_run"
    ],
    "properties": {
     "zone": {
      "type": "string"
     },
     "provider": {
      "type": "string"
     },
     "tenant": {
      "type": [
       "string",
       "null"
      ]
     },
     "full": {
      "const": true
     },
     "hosted": {
      "const": true
     },
     "dry_run": {
      "type": "boolean"
     },
     "valid": {
      "const": true,
      "description": "dry_run only"
     }
    }
   },
   "ProvisionRequest": {
    "type": "object",
    "required": [
     "zone",
     "provider",
     "credentials",
     "records"
    ],
    "properties": {
     "zone": {
      "type": "string"
     },
     "provider": {
      "type": "string"
     },
     "credentials": {
      "$ref": "#/components/schemas/Credentials"
     },
     "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
       "$ref": "#/components/schemas/RecordInput"
      }
     },
     "dry_run": {
      "type": "boolean"
     }
    }
   },
   "ProvisionResult": {
    "type": "object",
    "required": [
     "zone",
     "dry_run",
     "changes",
     "records"
    ],
    "properties": {
     "zone": {
      "type": "string"
     },
     "dry_run": {
      "type": "boolean"
     },
     "changes": {
      "$ref": "#/components/schemas/ChangeResult/properties/changes"
     },
     "records": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Record"
      },
      "description": "The zone's records after the change, as the DNS host reports them"
     }
    }
   },
   "ProviderField": {
    "type": "object",
    "required": [
     "name",
     "label",
     "secret",
     "required"
    ],
    "properties": {
     "name": {
      "type": "string",
      "description": "The key in the credential's fields",
      "examples": [
       "api_token"
      ]
     },
     "label": {
      "type": "string"
     },
     "secret": {
      "type": "boolean",
      "description": "A password or token: never shown again once saved"
     },
     "required": {
      "type": "boolean"
     },
     "default": {
      "type": "string"
     }
    }
   },
   "Provider": {
    "type": "object",
    "required": [
     "name",
     "label",
     "fields",
     "types"
    ],
    "properties": {
     "name": {
      "type": "string",
      "description": "As in Zone.provider",
      "examples": [
       "cloudflare"
      ]
     },
     "label": {
      "type": "string",
      "examples": [
       "Cloudflare"
      ]
     },
     "notes": {
      "type": "string",
      "description": "What the credential needs, for the person who makes it"
     },
     "types": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "Record types the DNS host supports"
     },
     "fields": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/ProviderField"
      }
     }
    }
   },
   "ProviderList": {
    "type": "object",
    "properties": {
     "providers": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Provider"
      }
     }
    }
   },
   "ZoneList": {
    "type": "object",
    "properties": {
     "zones": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Zone"
      }
     }
    }
   },
   "RecordList": {
    "type": "object",
    "properties": {
     "zone": {
      "type": "string"
     },
     "records": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Record"
      }
     }
    }
   },
   "RecordsRequest": {
    "type": "object",
    "required": [
     "records"
    ],
    "properties": {
     "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
       "$ref": "#/components/schemas/RecordInput"
      }
     },
     "dry_run": {
      "type": "boolean"
     }
    }
   },
   "DeleteRequest": {
    "type": "object",
    "required": [
     "records"
    ],
    "properties": {
     "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
       "$ref": "#/components/schemas/RecordMatch"
      }
     },
     "dry_run": {
      "type": "boolean"
     }
    }
