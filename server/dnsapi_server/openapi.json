   "Tenant": {
    "type": "object",
    "required": [
     "id",
     "name",
     "enabled",
     "zones",
     "created"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "enabled": {
      "type": "boolean"
     },
     "zones": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "created": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time"
     }
    }
   },
   "TenantList": {
    "type": "object",
    "properties": {
     "tenants": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Tenant"
      }
     }
    }
   },
   "TenantRequest": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
     },
     "enabled": {
      "type": "boolean"
     }
    }
   },
   "Restrict": {
    "oneOf": [
     {
      "type": "null"
     },
     {
      "const": "acme",
      "description": "_acme-challenge and _acme-challenge.* TXT records"
     },
     {
      "type": "object",
      "required": [
       "names"
      ],
      "properties": {
       "names": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "description": "Relative to the zone; * and ? are wildcards"
       },
       "types": {
        "type": "array",
        "items": {
         "type": "string"
        }
       }
      }
     }
    ]
   },
   "Key": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "owner": {
      "type": "string"
     },
     "scope": {
      "enum": [
       "read",
       "write"
      ]
     },
     "label": {
      "type": "string"
     },
     "allowlist": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "expires": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time"
     },
     "restrict": {
      "type": [
       "object",
       "null"
      ]
     },
     "created": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time"
     },
     "modified": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time",
      "description": "When the label, allowed addresses or expiry were last changed"
     },
     "last_used": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time"
     },
     "status": {
      "enum": [
       "active",
       "expired",
       "revoked"
      ]
     },
     "revoked": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time"
     },
     "revoked_reason": {
      "enum": [
       "revoked",
       "plain_http",
       null
      ],
      "description": "plain_http: revoked because the API received it over plain HTTP"
     }
    }
   },
   "KeyList": {
    "type": "object",
    "properties": {
     "keys": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Key"
      }
     }
    }
   },
   "KeyRequest": {
    "type": "object",
    "required": [
     "scope"
    ],
    "properties": {
     "scope": {
      "enum": [
       "read",
       "write"
      ]
     },
     "label": {
      "type": "string",
      "maxLength": 100
     },
     "allowlist": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "IP addresses or CIDR networks"
     },
     "expires": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time"
     },
     "restrict": {
      "$ref": "#/components/schemas/Restrict"
     }
    }
   },
   "KeyUpdate": {
    "type": "object",
    "minProperties": 1,
    "additionalProperties": false,
    "properties": {
     "label": {
      "type": "string",
      "maxLength": 100
     },
     "allowlist": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "IP addresses or CIDR networks; empty for any"
     },
     "expires": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time",
      "description": "In the future; null for never"
     }
    }
   },
   "NewKey": {
    "allOf": [
     {
      "$ref": "#/components/schemas/Key"
     },
     {
      "type": "object",
      "required": [
       "key"
      ],
      "properties": {
       "key": {
        "type": "string"
       }
      }
     }
    ]
   }
  }
 }
}
