     },
     "changes": {
      "type": "object",
      "properties": {
       "add": {
        "type": "array",
        "items": {
         "$ref": "#/components/schemas/Record"
        }
       },
       "remove": {
        "type": "array",
        "items": {
         "$ref": "#/components/schemas/Record"
        }
       }
      }
     },
     "warnings": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Warning"
      }
     },
     "records": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Record"
      },
      "description": "The zone's records after the change, as the DNS host reports them"
     }
    }
   },
   "Propagation": {
    "type": "object",
    "description": "dnshelper's check-propagation output",
    "properties": {
     "zone": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "type": {
      "type": "string"
     },
     "records": {
      "type": "array",
      "items": {
